{
  "name": "cps-academy-lms",
  "version": "1.0.0",
  "private": true,
  "description": "CPS Academy Learning Management System — Next.js + Strapi + PostgreSQL",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run develop --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run develop --prefix backend",
    "build": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "start": "cd backend && npm run start",
    "start:backend": "cd backend && npm run start",
    "test:backend": "npm test --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
