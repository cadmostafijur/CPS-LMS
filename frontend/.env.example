NEXT_PUBLIC_API_URL=http://127.0.0.1:1337/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sage AI (required for production on Vercel) ──
# Add these in Vercel → Project → Settings → Environment Variables
# (Production + Preview). They are SERVER-only — do NOT use NEXT_PUBLIC_.
# Token: https://agentrouter.org/console/token
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash

# Also set the same AGENTROUTER_* on Railway (backend) as a backup.
# Optional fallbacks:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
