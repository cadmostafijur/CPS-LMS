NEXT_PUBLIC_API_URL=http://127.0.0.1:1337/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sage AI (required for production on Vercel) ──
# Add in Vercel → Settings → Environment Variables (Production + Preview).
# SERVER-only — do NOT use NEXT_PUBLIC_ prefix.

# Recommended (free, works reliably from Vercel/Railway):
# GEMINI_API_KEY=your-key-from-https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.0-flash

# Optional backup (often blocked from cloud IPs — use Gemini as primary):
# AGENTROUTER_API_KEY=sk-your-token
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=deepseek-v4-flash

# Optional:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
