NEXT_PUBLIC_API_URL=http://127.0.0.1:1337/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI assistant (Sage) — create a token at https://agentrouter.org/console/token
# Agent Router is OpenAI-compatible: https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Use a model allowed on your token (e.g. deepseek-v4-flash, glm-5.3, gpt-5.6-sol)
AGENTROUTER_MODEL=deepseek-v4-flash

# Optional fallbacks if Agent Router is not set
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
