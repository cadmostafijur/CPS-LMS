NEXT_PUBLIC_API_URL=http://127.0.0.1:1337/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sage AI (required on FRONTEND / Vercel — NOT backend/.env) ──
# Create token: https://agentrouter.org/console/token
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Must match a model allowed on your token (glm-5.3, gpt-5.6-sol, deepseek-v4-flash, …)
AGENTROUTER_MODEL=deepseek-v4-flash

# Optional fallbacks if Agent Router is not set
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
