HOST=0.0.0.0
PORT=1337

# Secrets (change in every environment)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# CORS — comma-separated allowlist (never use * in production)
CORS_ORIGIN=http://localhost:3000

# Database — sqlite locally; postgres in production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production Postgres example:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/cps_lms
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=cps_lms
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
# DATABASE_SCHEMA=public

# Bootstrap seed
SEED_ON_BOOTSTRAP=true
SEED_ADMIN_EMAIL=admin@lms-demo.com
SEED_ADMIN_PASSWORD=DemoAdmin123!
