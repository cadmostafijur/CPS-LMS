HOST=0.0.0.0
PORT=1337

# Secrets (change in every environment)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# CORS — comma-separated allowlist (never use * in production)
CORS_ORIGIN=http://localhost:3000

# Database — Neon PostgreSQL (recommended for local + Railway)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SCHEMA=public

# Optional fallback if not using DATABASE_URL:
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=neondb
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# Local SQLite alternative (only if Neon is unavailable):
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Bootstrap seed
SEED_ON_BOOTSTRAP=true
SEED_ADMIN_EMAIL=admin@lms-demo.com
SEED_ADMIN_PASSWORD=DemoAdmin123!
