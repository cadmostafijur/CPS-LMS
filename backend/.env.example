HOST=0.0.0.0
PORT=1337

# Public base URL (required on Railway — do NOT use http://0.0.0.0)
# After generating a Railway domain, set e.g.:
# PUBLIC_URL=https://your-service.up.railway.app
# (RAILWAY_PUBLIC_DOMAIN is auto-injected; config will use https://$RAILWAY_PUBLIC_DOMAIN)
PUBLIC_URL=http://127.0.0.1:1337
IS_PROXIED=false

# Secrets (change in every environment)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# CORS — comma-separated allowlist (never use * in production)
CORS_ORIGIN=http://localhost:3000

# Database — Neon PostgreSQL (recommended for local + Railway)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SCHEMA=public

# Bootstrap seed
SEED_ON_BOOTSTRAP=true
SEED_ADMIN_EMAIL=admin@lms-demo.com
SEED_ADMIN_PASSWORD=DemoAdmin123!
