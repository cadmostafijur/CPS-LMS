{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": "LMS course"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "shortDescription": {
      "type": "string"
    },
    "thumbnailUrl": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"],
      "default": "DRAFT"
    },
    "isFree": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "decimal",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "discountPrice": {
      "type": "decimal"
    },
    "coverImageUrl": {
      "type": "text"
    },
    "difficulty": {
      "type": "enumeration",
      "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"],
      "default": "BEGINNER"
    },
    "language": {
      "type": "string",
      "default": "English"
    },
    "requirements": {
      "type": "text"
    },
    "outcomes": {
      "type": "text"
    },
    "tags": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "publishedAt": {
      "type": "datetime"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-category.course-category",
      "inversedBy": "courses"
    },
    "modules": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-module.course-module",
      "mappedBy": "course"
    },
    "instructor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "instructedCourses"
    },
    "coInstructors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "createdByUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "createdCourses"
    },
    "lessons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson.lesson",
      "mappedBy": "course"
    },
    "enrollments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "course"
    },
    "quizzes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz.quiz",
      "mappedBy": "course"
    },
    "certificates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::certificate.certificate",
      "mappedBy": "course"
    }
  }
}
