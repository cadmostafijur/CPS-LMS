    },
    "subtitle": {
      "type": "text"
    },
    "ctaLabel": {
      "type": "string"
    },
    "linkUrl": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "placement": {
      "type": "enumeration",
      "enum": ["HOME", "CATALOG", "BOTH"],
      "default": "BOTH"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
