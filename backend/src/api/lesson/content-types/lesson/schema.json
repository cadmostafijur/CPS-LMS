{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "Course lesson"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "text"
    },
    "contentVersions": {
      "type": "json"
    },
    "captionsUrl": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string"
    },
    "lessonType": {
      "type": "enumeration",
      "enum": ["TEXT", "VIDEO", "PDF", "URL", "AUDIO"],
      "default": "TEXT"
    },
    "documentUrl": {
      "type": "string"
    },
    "externalUrl": {
      "type": "string"
    },
    "isPreview": {
      "type": "boolean",
      "default": false
    },
    "durationMinutes": {
      "type": "integer",
      "default": 0
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "lessons"
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-module.course-module",
      "inversedBy": "lessons"
    }
  }
}
